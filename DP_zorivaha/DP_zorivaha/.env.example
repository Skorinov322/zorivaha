# =============================================================================
# Зори Ваха — переменные окружения
# Скопируйте в .env и заполните значения
# cp .env.example .env
# =============================================================================

# ── Django ────────────────────────────────────────────────────────────────────
SECRET_KEY=django-insecure-dev-key-change-in-production-minimum-50-chars-long
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
DJANGO_SETTINGS_MODULE=config.settings.dev

# ── Database ──────────────────────────────────────────────────────────────────
DB_NAME=zori_vaha
DB_USER=root
DB_PASSWORD=
DB_ROOT_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/2
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# ── Email (dev — письма выводятся в консоль) ──────────────────────────────────
EMAIL_BACKEND_DEV=console
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Зори Ваха <noreply@zorivaha.ru>
SERVER_EMAIL=errors@zorivaha.ru
ADMIN_EMAIL=admin@zorivaha.ru
EMAIL_TIMEOUT=10

# ── Sentry (опционально) ──────────────────────────────────────────────────────
SENTRY_DSN=

# ── Backup ────────────────────────────────────────────────────────────────────
BACKUP_DIR=/backups
BACKUP_RETENTION_DAYS=30

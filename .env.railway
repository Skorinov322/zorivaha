# =============================================================================
# Railway Environment Variables
# Скопируйте эти переменные в настройки Railway (Settings → Variables)
# =============================================================================

# ── Django (ОБЯЗАТЕЛЬНО) ──────────────────────────────────────────────────────
DJANGO_SETTINGS_MODULE=config.settings.prod
SECRET_KEY=ЗАМЕНИТЕ-НА-СЛУЧАЙНУЮ-СТРОКУ-МИНИМУМ-50-СИМВОЛОВ
DEBUG=False
ALLOWED_HOSTS=*.railway.app,ваш-домен.com

# ── Database (Railway автоматически создаст DATABASE_URL) ────────────────────
# DATABASE_URL будет создан автоматически при добавлении PostgreSQL

# ── HTTPS/Security ────────────────────────────────────────────────────────────
CSRF_TRUSTED_ORIGINS=https://ваш-проект.railway.app,https://ваш-домен.com

# ── Redis (Railway автоматически создаст REDIS_URL) ──────────────────────────
# REDIS_URL будет создан автоматически при добавлении Redis
# Для Celery используйте:
# CELERY_BROKER_URL=${{Redis.REDIS_URL}}/0
# CELERY_RESULT_BACKEND=${{Redis.REDIS_URL}}/1

# ── Email (ОПЦИОНАЛЬНО) ───────────────────────────────────────────────────────
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=ваш-email@gmail.com
EMAIL_HOST_PASSWORD=ваш-app-password
DEFAULT_FROM_EMAIL=Зори Ваха <noreply@zorivaha.ru>
SERVER_EMAIL=errors@zorivaha.ru
ADMIN_EMAIL=admin@zorivaha.ru
CONTACT_EMAIL=info@zorivaha.ru
CONTACT_PHONE=+7 (928) 000-00-00
EMAIL_TIMEOUT=10

# ── Sentry (ОПЦИОНАЛЬНО) ──────────────────────────────────────────────────────
SENTRY_DSN=

# ── Cloudinary (медиа-файлы) ──────────────────────────────────────────────────
CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME

# ── Static/Media ──────────────────────────────────────────────────────────────
STATIC_URL=/static/
MEDIA_URL=/media/

# =============================================================================
# Как сгенерировать SECRET_KEY:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# =============================================================================

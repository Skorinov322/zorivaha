# =============================================================================
# Production env for Docker/Yandex Cloud
# Copy to .env on the server and replace placeholders.
# =============================================================================

DJANGO_SETTINGS_MODULE=config.settings.prod
DEBUG=False
SECRET_KEY=change-me-to-a-long-random-secret-key-at-least-50-chars

# Example without domain:
# ALLOWED_HOSTS=203.0.113.10
# CSRF_TRUSTED_ORIGINS=http://203.0.113.10
ALLOWED_HOSTS=your-domain.ru,www.your-domain.ru
CSRF_TRUSTED_ORIGINS=https://your-domain.ru,https://www.your-domain.ru

# For first HTTP-only launch by IP, set these to False.
# After HTTPS is configured, set SESSION_COOKIE_SECURE=True and CSRF_COOKIE_SECURE=True.
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True

# PostgreSQL container from docker-compose.prod.yml
POSTGRES_DB=zorivaha
POSTGRES_USER=zorivaha_user
POSTGRES_PASSWORD=change-me-strong-db-password
DATABASE_URL=postgres://zorivaha_user:change-me-strong-db-password@db:5432/zorivaha

# Redis container
REDIS_URL=redis://redis:6379/2
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# Email
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Zori Vaha <noreply@your-domain.ru>
SERVER_EMAIL=errors@your-domain.ru
ADMIN_EMAIL=admin@your-domain.ru
EMAIL_TIMEOUT=10

# Public contact details shown across the website
CONTACT_EMAIL=zorivaha@mail.ru
CONTACT_PHONE=+7 (346) 628-70-03
CONTACT_PHONE_SECOND=+7 (995) 097-30-59

# Optional
SENTRY_DSN=
BACKUP_DIR=/backups
BACKUP_RETENTION_DAYS=30

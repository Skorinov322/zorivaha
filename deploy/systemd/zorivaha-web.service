[Unit]
Description=Зори Ваха — Gunicorn Web Server
Documentation=https://docs.gunicorn.org
After=network.target mysql.service redis.service
Requires=mysql.service redis.service

[Service]
Type=notify
User=zorivaha
Group=zorivaha
WorkingDirectory=/var/www/zorivaha
RuntimeDirectory=gunicorn
RuntimeDirectoryMode=0755

# Environment
EnvironmentFile=/var/www/zorivaha/.env
Environment="DJANGO_SETTINGS_MODULE=config.settings.prod"

# Gunicorn
ExecStart=/var/www/zorivaha/venv/bin/gunicorn \
    config.wsgi:application \
    --bind unix:/run/gunicorn/zorivaha.sock \
    --workers 4 \
    --worker-class sync \
    --timeout 120 \
    --keepalive 5 \
    --max-requests 1000 \
    --max-requests-jitter 100 \
    --log-level info \
    --access-logfile /var/log/zorivaha/access.log \
    --error-logfile /var/log/zorivaha/error.log

ExecReload=/bin/kill -s HUP $MAINPID
ExecStop=/bin/kill -s TERM $MAINPID

# Restart policy
Restart=on-failure
RestartSec=5s
StartLimitInterval=60s
StartLimitBurst=3

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/www/zorivaha /var/log/zorivaha /run/gunicorn

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=zorivaha-web

[Install]
WantedBy=multi-user.target

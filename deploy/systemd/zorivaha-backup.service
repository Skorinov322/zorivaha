[Unit]
Description=Зори Ваха — Database Backup
After=mysql.service

[Service]
Type=oneshot
User=zorivaha
Group=zorivaha
WorkingDirectory=/var/www/zorivaha

EnvironmentFile=/var/www/zorivaha/.env
Environment="MYSQL_PWD=${DB_PASSWORD}"

ExecStart=/var/www/zorivaha/deploy/backup/backup.sh

StandardOutput=journal
StandardError=journal
SyslogIdentifier=zorivaha-backup

[Unit]
Description=Зори Ваха — Celery Worker
Documentation=https://docs.celeryq.dev
After=network.target mysql.service redis.service
Requires=mysql.service redis.service

[Service]
Type=forking
User=zorivaha
Group=zorivaha
WorkingDirectory=/var/www/zorivaha

EnvironmentFile=/var/www/zorivaha/.env
Environment="DJANGO_SETTINGS_MODULE=config.settings.prod"

ExecStart=/var/www/zorivaha/venv/bin/celery \
    -A config worker \
    --loglevel=info \
    --concurrency=4 \
    --max-tasks-per-child=200 \
    --without-gossip \
    --without-mingle \
    --logfile=/var/log/zorivaha/celery-worker.log \
    --pidfile=/run/zorivaha/celery-worker.pid \
    --detach

ExecStop=/bin/kill -s TERM $MAINPID
ExecReload=/bin/kill -s HUP $MAINPID

Restart=on-failure
RestartSec=10s

NoNewPrivileges=true
PrivateTmp=true
RuntimeDirectory=zorivaha
RuntimeDirectoryMode=0755
ReadWritePaths=/var/www/zorivaha /var/log/zorivaha /run/zorivaha

StandardOutput=journal
StandardError=journal
SyslogIdentifier=zorivaha-celery-worker

[Install]
WantedBy=multi-user.target

[Unit]
Description=Зори Ваха — Daily Database Backup Timer
Requires=zorivaha-backup.service

[Timer]
# Run daily at 03:00
OnCalendar=*-*-* 03:00:00
# Run immediately if last run was missed
Persistent=true
# Add random delay up to 5 minutes to avoid thundering herd
RandomizedDelaySec=300

[Install]
WantedBy=timers.target
